####### Compile

Lexico.o: ../../Lexico.cpp ../../Lexico.h \
		../../Token.h \
		../../RegistradorConsola.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Lexico.o ../../Lexico.cpp

Pila.o: ../../Pila.cpp ../../Pila.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Pila.o ../../Pila.cpp

Sintactico.o: ../../Sintactico.cpp ../../Sintactico.h \
		../../Token.h \
		../../TablaSimbolos.h \
		../../RegistradorConsola.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Sintactico.o ../../Sintactico.cpp

TablaSimbolos.o: ../../TablaSimbolos.cpp ../../TablaSimbolos.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o TablaSimbolos.o ../../TablaSimbolos.cpp

main.o: ../../main.cpp ../../dialog.h \
		../../resaltador.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../main.cpp

dialog.o: ../../dialog.cpp ../../dialog.h \
		../../resaltador.h \
		ui_dialog.h \
		../../RegistradorConsola.h \
		../../Lexico.h \
		../../Token.h \
		../../Sintactico.h \
		../../TablaSimbolos.h \
		../../Pila.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o dialog.o ../../dialog.cpp

resaltador.o: ../../resaltador.cpp ../../resaltador.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o resaltador.o ../../resaltador.cpp

qrc_images.o: qrc_images.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_images.o qrc_images.cpp

moc_dialog.o: moc_dialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_dialog.o moc_dialog.cpp

moc_resaltador.o: moc_resaltador.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_resaltador.o moc_resaltador.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/Poke_Compilator/bin || mkdir -p $(INSTALL_ROOT)/opt/Poke_Compilator/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/Poke_Compilator/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/Poke_Compilator/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/Poke_Compilator/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

